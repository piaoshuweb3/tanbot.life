// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ===== 主理人（街头主理人）=====
model Manager {
  id           String   @id @default(cuid())
  username     String   @unique
  phone        String?  @unique
  wechatOpenId String?  @unique
  passwordHash String
  realName     String?
  nodeId       String?  @unique // 烟火节点编号 #001
  city         String?
  category     String?  // 经营品类
  creditScore  Int      @default(80)
  status       String   @default("active") // active / suspended / pending
  role         String   @default("manager") // manager / admin
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  revenues     Revenue[]
  inspections  Inspection[]
  sessions     Session[]
}

// ===== 营收记录 =====
model Revenue {
  id        String   @id @default(cuid())
  managerId String
  date      DateTime
  amount    Int // 日营收（元）
  packages  String? // 套餐销售占比 JSON
  note      String?
  createdAt DateTime @default(now())

  manager Manager @relation(fields: [managerId], references: [id], onDelete: Cascade)

  @@index([managerId, date])
}

// ===== 巡店记录 =====
model Inspection {
  id          String   @id @default(cuid())
  managerId   String
  date        DateTime
  overall     Int
  roast       Int
  plating     Int
  portion     Int
  branding    Int
  hygiene     Int
  pass        Boolean
  creditDelta Int
  summary     String?
  suggestion  String?
  createdAt   DateTime @default(now())

  manager Manager @relation(fields: [managerId], references: [id], onDelete: Cascade)

  @@index([managerId, date])
}

// ===== 会话 =====
model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  managerId String
  expiresAt DateTime
  createdAt DateTime @default(now())

  manager Manager @relation(fields: [managerId], references: [id], onDelete: Cascade)

  @@index([token])
}

// ===== 纪录片 =====
model Documentary {
  id          String   @id @default(cuid())
  episode     Int // 集数
  title       String
  description String?
  videoUrl    String // 视频地址（外链或对象存储）
  coverUrl    String? // 封面图
  duration    Int? // 时长（秒）
  status      String   @default("published") // published / draft
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ===== AI 模型配置 =====
model AIModel {
  id          String   @id @default(cuid())
  key         String   @unique // 模型标识，如 deepseek / qwen / glm
  name        String // 显示名称
  provider    String // 提供商
  category    String   @default("paid") // paid / free
  apiEndpoint String? // 接口地址
  apiKey      String? // 密钥（加密存储）
  enabled     Boolean  @default(false)
  isDefault   Boolean  @default(false)
  priority    Int      @default(0)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
