# ===== 烟火节点 TANBOT.LIFE 环境变量示例 =====
# 复制为 .env 并填入真实值。Vercel 部署请在 Settings → Environment Variables 配置。

# 数据库（本地开发用 SQLite 文件；Vercel 生产必须用 Turso 云库）
# 本地：DATABASE_URL=file:./db/custom.db
# 生产（Turso）：libsql://tanbot-xxx.turso.io?authToken=你的turso_token
DATABASE_URL=file:./db/custom.db

# DeepSeek API（AI 客服 / 经营参谋 / 套餐工坊）
# 获取：https://platform.deepseek.com → API Keys
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# LLM 引擎高级配置（可选，默认走 DeepSeek）
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# AI 巡店官视觉模型（可选，OpenAI 兼容 /chat/completions）
# 支持智谱 GLM-4V、通义千问 Qwen-VL、Kimi Vision 等任意视觉模型
# 示例（智谱）：
# VISION_API_URL=https://open.bigmodel.cn/api/paas/v4
# VISION_API_KEY=your_zhipu_key
# VISION_MODEL=glm-4v-flash
# 示例（通义千问）：
# VISION_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# VISION_API_KEY=your_qwen_key
# VISION_MODEL=qwen-vl-plus
# 未配置时 AI 巡店官返回明确提示（不崩溃），可配置 .z-ai-config 走 z-ai SDK
